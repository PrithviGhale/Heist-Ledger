<Window x:Class="GTAEarningsTracker.CaptureSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Capture Area"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#66000000"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Grid x:Name="SelectionSurface" Background="Transparent">
        <Canvas IsHitTestVisible="False">
            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    BorderBrush="#FF56D889"
                    BorderThickness="3"
                    Background="#2256D889"
                    CornerRadius="2" />
        </Canvas>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20"
                Padding="18,12"
                Background="#EB171B22"
                BorderBrush="#6656D889"
                BorderThickness="1"
                CornerRadius="10"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="Select TOTAL CASH EARNED and the complete amount" />
                <TextBlock HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           Foreground="#FFAAB2BF"
                           FontSize="11"
                           Text="Leave padding on every side &#x00B7; Minimum 300 &#x00D7; 100 pixels &#x00B7; Escape cancels" />
                <TextBlock x:Name="SelectionStatusText"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           Foreground="#FFFF8A8A"
                           FontSize="11"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
