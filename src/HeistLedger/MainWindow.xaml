                                <Button Margin="0,9,0,0"
                                        Style="{DynamicResource PrimaryButton}"
                                        Content="Apply Shortcut"
                                        Click="ApplyHotkeyButton_Click" />
                                <TextBlock x:Name="HotkeyRegistrationStatusText"
                                           Margin="0,9,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Text="Registration status: Waiting for startup"
                                           TextWrapping="Wrap" />

                                <Border Height="1" Margin="0,18,0,16" Background="{DynamicResource MutedBorderBrush}" />
                                <TextBlock Style="{DynamicResource MicroLabel}" Text="MINIMIZE APP SHORTCUT" />
                                <CheckBox x:Name="MinimizeHotkeyEnabledCheckBox"
                                          Margin="0,14,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          Content="Enable minimize shortcut" />
                                <Border Margin="0,13,0,0"
                                        Padding="12"
                                        Background="{DynamicResource SecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource MutedBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{DynamicResource MicroLabel}" FontSize="9" Text="CURRENT MINIMIZE SHORTCUT" />
                                            <TextBlock x:Name="CurrentMinimizeHotkeyText" Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="Ctrl + Shift + M" />
                                        </StackPanel>
                                        <TextBlock x:Name="ProposedMinimizeHotkeyText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource ScannerCyanBrush}" FontSize="11" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="MinimizeHotkeyWarningText" Visibility="Collapsed" Margin="0,9,0,0" Foreground="{DynamicResource WarningGoldBrush}" FontSize="10" TextWrapping="Wrap" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="RecordMinimizeHotkeyButton" Style="{DynamicResource SecondaryButton}" Content="Record Minimize Shortcut" Click="RecordMinimizeHotkeyButton_Click" />
                                    <Button Grid.Column="2" Style="{DynamicResource GhostButton}" Content="Reset to Ctrl + Shift + M" Click="ResetMinimizeHotkeyButton_Click" />
                                </Grid>
                                <Button Margin="0,9,0,0" Style="{DynamicResource PrimaryButton}" Content="Apply Minimize Shortcut" Click="ApplyMinimizeHotkeyButton_Click" />
                                <TextBlock x:Name="MinimizeHotkeyRegistrationStatusText" Margin="0,9,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Text="Registration status: Waiting for startup" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource MicroLabel}" Text="WINDOW BEHAVIOR" />
                                <CheckBox x:Name="AlwaysOnTopSettingCheckBox"
                                          Margin="0,14,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          Content="Always on top"
                                          Click="WindowSettingCheckBox_Click" />
                                <CheckBox x:Name="RememberWindowPositionCheckBox"
                                          Margin="0,12,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          Content="Remember window position"
                                          Click="WindowSettingCheckBox_Click" />
                                <CheckBox x:Name="StartCompactSettingCheckBox"
                                          Margin="0,12,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          Content="Start in compact mode"
                                          Click="StartCompactSettingCheckBox_Click" />
                                <CheckBox x:Name="PauseLivePreviewWhenHiddenCheckBox"
                                          Margin="0,12,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          Content="Pause preview rendering while hidden"
                                          Click="WindowSettingCheckBox_Click" />
                                <CheckBox x:Name="ContinueScannerWhileHiddenCheckBox"
                                          Visibility="Collapsed"
                                          Margin="0,12,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          Content="Continue scanner while hidden"
                                          Click="WindowSettingCheckBox_Click" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="10"
                                           Text="Quick Scan and minimize use separate shortcuts. Quick Scan can capture while the app is minimized, then returns with the result ready for confirmation."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource MicroLabel}" Text="OCR ENGINES" />
                                <CheckBox Margin="0,13,0,0"
                                          IsChecked="True"
                                          IsEnabled="False"
                                          Content="Tesseract — enabled and required" />
                                <CheckBox x:Name="PaddleOcrEnabledCheckBox"
                                          Margin="0,12,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="True"
                                          Content="PaddleOCR AI reader"
                                          Click="PaddleOcrEnabledCheckBox_Click" />
                                <CheckBox Margin="0,12,0,0"
                                          IsChecked="True"
                                          IsEnabled="False"
                                          Content="GTA digit reader — enabled and required" />
                                <TextBlock x:Name="PaddleOcrModelStatusText"
                                           Margin="0,12,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Text="AI model status: Loading local model…"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="PaddleOcrLoadTimeText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="10"
                                           Text="AI model load time: --" />
                                <TextBlock x:Name="PaddleOcrLatestTimeText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="10"
                                           Text="Latest PaddleOCR processing time: --" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource MicroLabel}" Text="SCANNER PERFORMANCE" />
                                <ComboBox x:Name="ScannerAreaModeComboBox"
                                          Visibility="Collapsed"
                                          SelectedIndex="1">
                                    <ComboBoxItem Tag="AutoLocate" Content="Legacy Auto Locate" />
                                    <ComboBoxItem Tag="SelectedRegion" Content="Selected Region" />
                                </ComboBox>
                                <TextBlock Margin="0,11,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Text="Detection mode" />
                                <ComboBox x:Name="ScannerDetectionModeComboBox"
                                          Height="36"
                                          Margin="0,6,0,0"
                                          SelectionChanged="ScannerDetectionModeComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="Fast" Content="Fast &#x2014; recommended" />
                                    <ComboBoxItem Tag="Balanced" Content="Balanced" />
                                    <ComboBoxItem Tag="Thorough" Content="Thorough &#x2014; troubleshooting" />
                                </ComboBox>
                                <CheckBox x:Name="ShowTrayNotificationCheckBox"
                                          Margin="0,13,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          Content="Show tray notification after detected payout"
                                          Click="WindowSettingCheckBox_Click" />
                                <CheckBox x:Name="ShowScannerPerformanceDiagnosticsCheckBox"
                                          Margin="0,12,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          Content="Show scanner performance diagnostics"
                                          Click="WindowSettingCheckBox_Click" />
                                <CheckBox Margin="0,12,0,0"
                                          IsChecked="True"
                                          IsEnabled="False"
                                          Content="Require confirmation for uncertain results &#x2014; always on" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource MicroLabel}" Text="QUICK SCAN" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           Text="Quick Scan analyzes only your confirmed payout rectangle using a five-frame in-memory verification burst."
                                           TextWrapping="Wrap" />
                                <ComboBox x:Name="QuickCaptureMonitorComboBox"
                                          Visibility="Collapsed" />
                                <CheckBox x:Name="RequireQuickConfirmationCheckBox"
                                          Margin="0,13,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          IsChecked="True"
                                          IsEnabled="False"
                                          Content="Always verify a detected amount before saving" />
                                <TextBlock x:Name="SettingsCaptureAreaText"
                                           Margin="0,13,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Text="Selected payout area: Not selected"
                                           TextWrapping="Wrap" />
                                <Border Height="145"
                                        Margin="0,12,0,0"
                                        Background="{DynamicResource PreviewBackgroundBrush}"
                                        BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="SettingsCapturePreviewImage" Margin="6" Stretch="Uniform" />
                                        <StackPanel x:Name="SettingsCapturePreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource ScannerCyanBrush}" FontSize="20" Text="▣" />
                                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Text="Capture-area preview" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Button Margin="0,9,0,0"
                                        Style="{DynamicResource PrimaryButton}"
                                        Content="PREVIEW SELECTED AREA"
                                        Click="PreviewSettingsCaptureButton_Click" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{DynamicResource SecondaryButton}"
                                            Content="CHANGE CAPTURE AREA"
                                            Click="SelectCaptureAreaButton_Click" />
                                    <Button Grid.Column="2"
                                            Style="{DynamicResource DangerButton}"
                                            Content="RESET CAPTURE AREA"
                                            Click="ClearCaptureAreaButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource MicroLabel}" Text="DISCORD WEBHOOK" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   Text="Post confirmed Quick Scan payouts to your server."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Padding="9,5"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource AccentSurfaceBrush}"
                                            BorderBrush="{DynamicResource AccentBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <TextBlock Foreground="{DynamicResource EarningsGreenBrush}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Text="OPT-IN" />
                                    </Border>
                                </Grid>

                                <TextBlock Margin="0,14,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Text="Discord webhook URL" />
                                <Border Height="40"
                                        Margin="0,6,0,0"
                                        Background="{DynamicResource SecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <PasswordBox x:Name="DiscordWebhookPasswordBox"
                                                 Padding="12,0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 CaretBrush="{DynamicResource PrimaryTextBrush}"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 FontFamily="Segoe UI Variable Text, Segoe UI"
                                                 FontSize="12"
                                                 MaxLength="500"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Server Settings > Integrations > Webhooks > Copy Webhook URL" />
                                </Border>

                                <CheckBox x:Name="DiscordEnabledCheckBox"
                                          Margin="0,14,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          Content="Send confirmed Quick Scan payouts" />
                                <CheckBox x:Name="DiscordIncludeScreenshotCheckBox"
                                          Margin="0,12,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          Content="Attach the in-memory payout preview" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SaveDiscordSettingsButton"
                                            Style="{DynamicResource PrimaryButton}"
                                            Content="SAVE DISCORD"
                                            Click="SaveDiscordSettingsButton_Click" />
                                    <Button x:Name="TestDiscordWebhookButton"
                                            Grid.Column="2"
                                            Style="{DynamicResource SecondaryButton}"
                                            Content="SEND TEST"
                                            Click="TestDiscordWebhookButton_Click" />
                                </Grid>

                                <TextBlock x:Name="DiscordStatusText"
                                           Margin="0,10,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Text="Add a username and webhook URL, then save."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="9"
                                           LineHeight="14"
                                           Text="The webhook token is encrypted for your current Windows account. A screenshot is uploaded only after you confirm a Quick Scan and only when attachment sharing is enabled."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource MicroLabel}" Text="PRIVACY AND SAFETY" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           LineHeight="19"
                                           Text="• OCR runs locally&#x0a;• Captured images are processed in memory&#x0a;• Payout previews upload only when Discord sharing is enabled&#x0a;• No game memory is accessed&#x0a;• No game files are changed&#x0a;• No keyboard or mouse input is automated"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="CaptureSetupPanel"
                  Grid.Row="2"
                  Panel.ZIndex="30"
                  Visibility="Collapsed"
                  Margin="24,8,24,24">
                <Border Padding="26"
                        VerticalAlignment="Center"
                        Background="{DynamicResource HeroCardBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource EarningsGreenBrush}" FontSize="11" FontWeight="SemiBold" Text="HEIST LEDGER" />
                        <TextBlock Margin="0,10,0,0" FontSize="25" FontWeight="SemiBold" Text="Set up your payout scanner" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   LineHeight="19"
                                   Text="Select either the complete TOTAL CASH EARNED result or the green cash icon with the full amount beside it. Leave a small border around everything."
                                   TextWrapping="Wrap" />
                        <Border x:Name="SetupPreviewBorder"
                                Visibility="Collapsed"
                                Height="120"
                                Margin="0,16,0,0"
                                Background="{DynamicResource PreviewBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                ClipToBounds="True">
                            <Image x:Name="SetupPreviewImage" Margin="6" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="SetupStatusText"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource EarningsGreenBrush}"
                                   FontSize="11"
                                   Text="Select a payout area to continue."
                                   TextWrapping="Wrap" />
                        <Button x:Name="SetupSelectAreaButton"
                                Height="46"
                                Margin="0,16,0,0"
                                Style="{DynamicResource PrimaryButton}"
                                Content="SELECT PAYOUT AREA"
                                Click="SelectCaptureAreaButton_Click" />
                        <TextBlock Margin="0,13,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10"
                                   LineHeight="16"
                                   Text="You only need to do this again if you change resolution, display mode, monitor, or where the result appears."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="CompactDashboard"
                  Grid.Row="2"
                  Visibility="Collapsed"
                  Margin="16,0,16,14"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" />
                </Grid.RenderTransform>
                <Grid x:Name="CompactNormalPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="12" Background="{DynamicResource HeroCardBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource MicroLabel}" FontSize="8" Text="LAST 24 HOURS" />
                            <TextBlock x:Name="CompactDayTotalText" Margin="0,4,0,0" Foreground="{DynamicResource EarningsGreenBrush}" FontFamily="Impact, Haettenschweiler, Arial Narrow" FontSize="27" Text="$0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CompactDayCountdownText" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="8" Text="Starts with your next payout" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="10" Background="{DynamicResource ElevatedCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource MicroLabel}" FontSize="8" Text="7 DAYS" />
                                <TextBlock x:Name="CompactWeekTotalText" Margin="0,4,0,0" FontFamily="Impact, Haettenschweiler, Arial Narrow" FontSize="17" Text="$0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CompactWeekCountdownText" Margin="0,3,0,0" Foreground="{DynamicResource ScannerCyanBrush}" FontFamily="Consolas" FontSize="8" Text="Starts with your next payout" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="10" Background="{DynamicResource ElevatedCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource MicroLabel}" FontSize="8" Text="LAST PAYOUT" />
                                <TextBlock x:Name="CompactLastPayoutText" Margin="0,4,0,0" FontFamily="Impact, Haettenschweiler, Arial Narrow" FontSize="17" Text="$0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="2,10,2,0">
                        <Grid x:Name="CompactStatusPanel">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="CompactCaptureReadyDot" Width="7" Height="7" Fill="{DynamicResource WarningGoldBrush}" />
                                <TextBlock x:Name="CompactCaptureReadyText" Margin="6,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" Text="AREA REQUIRED" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="9"
                                       Text="5-FRAME VERIFIED SCAN" />
                        </Grid>
                        <Border x:Name="CompactScanMessageBorder"
                                Visibility="Collapsed"
                                Padding="8,4"
                                Background="{DynamicResource AccentSurfaceBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="-5" />
                            </Border.RenderTransform>
                            <TextBlock x:Name="CompactScanMessageText"
                                       Foreground="{DynamicResource EarningsGreenBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                    <Button x:Name="CompactQuickCaptureButton"
                            Grid.Row="3"
                            Height="48"
                            Margin="0,10,0,0"
                            Style="{DynamicResource PrimaryButton}"
                            FontSize="12"
                            Content="QUICK SCAN"
                            Click="QuickCaptureButton_Click" />
                </Grid>

                <Border x:Name="CompactPendingIndicator"
                        Visibility="Collapsed"
                        Padding="14"
                        Background="{DynamicResource AccentSurfaceBrush}"
                        BorderBrush="{DynamicResource EarningsGreenBrush}"
                        BorderThickness="1.5"
                        CornerRadius="13">
                    <StackPanel>
                        <TextBlock x:Name="CompactPendingHeadingText" Foreground="{DynamicResource EarningsGreenBrush}" FontSize="10" FontWeight="SemiBold" Text="PAYOUT FOUND — VERIFY BEFORE SAVING" />
                        <TextBlock x:Name="CompactPendingText" Margin="0,6,0,0" FontFamily="Impact, Haettenschweiler, Arial Narrow" FontSize="30" Text="$0" />
                        <TextBlock x:Name="CompactPendingMetaText" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Text="Confidence: --  •  Readers agreeing: --" TextWrapping="Wrap" />
                        <TextBlock x:Name="CompactVerificationStatusText" Margin="0,3,0,0" Foreground="{DynamicResource WarningGoldBrush}" FontSize="10" FontWeight="SemiBold" Text="VERIFICATION REQUIRED" />
                        <TextBlock x:Name="CompactPendingConflictText" Margin="0,3,0,0" Foreground="{DynamicResource WarningGoldBrush}" FontSize="10" Text="Possible conflict: None" TextWrapping="Wrap" />
                        <Border x:Name="CompactPreviousResultBorder" Visibility="Collapsed" Margin="0,7,0,0" Padding="7" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource WarningGoldBrush}" BorderThickness="1" CornerRadius="7">
                            <TextBlock x:Name="CompactPreviousResultText" Foreground="{DynamicResource WarningGoldBrush}" FontSize="9" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock x:Name="CompactScanAttemptsText" Visibility="Collapsed" Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9"
                                   Text="Compare the amount with GTA. Edit it if any digit is wrong."
                                   TextWrapping="Wrap" />
                        <Border Height="92" Margin="0,9,0,0" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource MutedBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <Image x:Name="CompactPendingPreviewImage" Margin="4" Stretch="Uniform" />
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CompactAcceptButton" Height="40" Style="{DynamicResource PrimaryButton}" Content="ACCEPT" Click="ConfirmPayoutButton_Click" />
                            <Button x:Name="CompactEditButton" Grid.Column="2" Height="40" Style="{DynamicResource SecondaryButton}" Content="EDIT" Click="EditDetectedAmountButton_Click" />
                            <Button x:Name="CompactRescanButton" Grid.Row="2" Height="40" Style="{DynamicResource SecondaryButton}" Content="RESCAN" Click="RescanPayoutButton_Click" />
                            <Button x:Name="CompactRejectButton" Grid.Row="2" Grid.Column="2" Height="40" Style="{DynamicResource DangerButton}" Content="REJECT" Click="RejectPayoutButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="CompactEditPanel" Visibility="Collapsed" Padding="14" Background="{DynamicResource ElevatedCardBrush}" BorderBrush="{DynamicResource ScannerCyanBrush}" BorderThickness="1" CornerRadius="13">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource MicroLabel}" Text="EDIT DETECTED AMOUNT" />
                        <Border Height="100" Margin="0,9,0,0" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource MutedBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <Image x:Name="CompactEditPreviewImage" Margin="4" Stretch="Uniform" />
                        </Border>
                        <TextBlock Margin="2,6,2,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" Text="Read the exact amount from this captured GTA image, then enter it below." TextWrapping="Wrap" />
                        <TextBox x:Name="CompactEditAmountTextBox" Height="46" Margin="0,10,0,0" Padding="12,0" Style="{DynamicResource PremiumAmountTextBox}" FontFamily="Impact, Haettenschweiler, Arial Narrow" FontSize="19" VerticalContentAlignment="Center" KeyDown="PendingEditTextBox_KeyDown" />
                        <TextBlock x:Name="CompactEditValidationText" MinHeight="14" Margin="2,6,2,0" Foreground="{DynamicResource ErrorRedBrush}" FontSize="10" TextWrapping="Wrap" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Style="{DynamicResource PrimaryButton}" Content="SAVE PAYOUT" Click="SaveEditedPayoutButton_Click" />
                            <Button Grid.Column="2" Style="{DynamicResource GhostButton}" Content="CANCEL" Click="CancelEditedPayoutButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>

            <Border x:Name="QuickCaptureNotification"
                    Grid.Row="2"
                    Panel.ZIndex="50"
                    Visibility="Collapsed"
                    Width="285"
                    Margin="0,14,18,0"
                    Padding="14"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ElevatedCardBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="QuickCaptureNotificationAmount"
                                   Foreground="{DynamicResource EarningsGreenBrush}"
                                   FontFamily="Impact, Haettenschweiler, Arial Narrow"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="Added $0" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"
                                   Text="Quick Capture" />
                    </StackPanel>
                    <Button x:Name="QuickCaptureNotificationUndoButton"
                            Grid.Column="1"
                            Height="32"
                            Margin="12,0,0,0"
                            Padding="12,0"
                            Style="{DynamicResource GhostButton}"
                            Content="Undo"
                            Click="QuickCaptureUndoButton_Click" />
                </Grid>
            </Border>

            <Grid x:Name="LoadingOverlay"
                  Grid.RowSpan="3"
                  Panel.ZIndex="200"
                  IsHitTestVisible="True">
                <Grid.Background>
                    <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.78" RadiusY="0.78">
                        <GradientStop Color="{DynamicResource ElevatedCardColor}" Offset="0" />
                        <GradientStop Color="{DynamicResource MainBackgroundColor}" Offset="0.62" />
                        <GradientStop Color="#FF030508" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Background>
                <Border Width="320" Height="900" Background="{DynamicResource AccentSurfaceBrush}" Opacity="0.35" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><RotateTransform Angle="24" /></Border.RenderTransform>
                </Border>
                <Viewbox Margin="32" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="LoadingContent" Width="360" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LoadingContentScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="LoadingContentTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <StackPanel>
                        <Grid x:Name="LoadingEmblem" Width="96" Height="96" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                            <Border Margin="5" CornerRadius="22" BorderBrush="{DynamicResource ScannerCyanBrush}" BorderThickness="1" Opacity="0.4" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><RotateTransform Angle="-12" /></Border.RenderTransform>
                            </Border>
                            <Border Margin="5" CornerRadius="22" Background="{DynamicResource ElevatedCardBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                                <Image Margin="10" Source="Assets/AppIcon.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="LoadingWordmark" Margin="5,22,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" Text="H E I S T   L E D G E R">
                            <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                        </TextBlock>
                        <StackPanel x:Name="LoadingGreeting" Margin="0,24,0,0">
                            <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                            <TextBlock x:Name="GreetingPrefixText" Foreground="{DynamicResource ScannerCyanBrush}" FontFamily="Segoe Script, Brush Script MT" FontSize="29" Text="Welcome," />
                            <TextBlock x:Name="GreetingNameText" Margin="2,2,0,0" MaxWidth="350" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" Foreground="{DynamicResource EarningsGreenBrush}" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="42" FontWeight="SemiBold" Text="Player" />
                        </StackPanel>
                        <TextBlock x:Name="LoadingStatusText" Margin="5,22,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Text="Preparing your next score…" />
                        <Border Height="3" Width="350" Margin="5,15,5,8" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="2" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="LoadingProgressBar" Width="0" HorizontalAlignment="Left" Background="{DynamicResource EarningsGreenBrush}" CornerRadius="2" />
                                <Border Width="70" HorizontalAlignment="Left" Opacity="0.55">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="Transparent" Offset="0" />
                                            <GradientStop Color="White" Offset="0.5" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform><TranslateTransform x:Name="LoadingProgressSheenTransform" X="-90" /></Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
                </Viewbox>
            </Grid>
        </Grid>
    </Border>
    <Image x:Name="ModeTransitionPreview" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="LowQuality" />
    </Grid>
</Window>
