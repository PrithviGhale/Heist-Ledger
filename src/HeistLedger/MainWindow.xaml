<Window x:Class="GTAEarningsTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heist Ledger"
        Icon="Assets/AppIcon.ico"
        Width="500"
        Height="760"
        MinWidth="460"
        MinHeight="650"
        MaxWidth="560"
        SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Topmost="True"
        ShowInTaskbar="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="WindowHost">
    <Border Margin="8" CornerRadius="26" Background="{DynamicResource MainBackgroundBrush}" IsHitTestVisible="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.32" Color="Black" />
        </Border.Effect>
    </Border>
    <Border x:Name="WindowChrome"
            Margin="8"
            Background="{DynamicResource DashboardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="26"
            ClipToBounds="True">
        <Grid x:Name="WindowContent" SizeChanged="WindowContent_SizeChanged">
            <Grid.Clip><RectangleGeometry x:Name="WindowContentClip" RadiusX="25" RadiusY="25" /></Grid.Clip>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="AmbientGlowOne"
                     Grid.RowSpan="3"
                     Width="460"
                     Height="460"
                     Margin="-230,-120,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     IsHitTestVisible="False"
                     Opacity="0.10"
                     CornerRadius="230"
                     RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource EarningsGreenColor}" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="-18" />
                        <TranslateTransform x:Name="AmbientGlowOneTransform" />
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>
            <Border x:Name="AmbientGlowTwo"
                     Grid.RowSpan="3"
                     Width="430"
                     Height="430"
                     Margin="0,0,-230,-160"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     IsHitTestVisible="False"
                     Opacity="0.075"
                     CornerRadius="215"
                     RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource ScannerCyanColor}" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="15" />
                        <TranslateTransform x:Name="AmbientGlowTwoTransform" />
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>
            <Border Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.018">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="Transparent">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="{DynamicResource PrimaryTextBrush}" Thickness="0.6" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="32,0" />
                                        <LineGeometry StartPoint="0,0" EndPoint="0,32" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="AmbientGridTransform" />
                </Border.RenderTransform>
            </Border>

            <Grid x:Name="FixedTitleBar"
                  Grid.Row="0"
                  Margin="20,0,16,0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="30"
                       Height="30"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="Assets/AppIcon.png"
                       Stretch="Uniform"
                       ToolTip="HEIST LEDGER" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="HEIST LEDGER" />
                    <TextBlock x:Name="ExpandedTitleSubtitle"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource EarningsGreenBrush}"
                               FontSize="8"
                               FontWeight="SemiBold"
                               Text="EARNINGS INTELLIGENCE" />
                    <StackPanel x:Name="CompactTitleScannerPanel"
                                Visibility="Collapsed"
                                Margin="0,2,0,0"
                                Orientation="Horizontal">
                        <Ellipse x:Name="CompactLiveScannerDot"
                                 Width="6"
                                 Height="6"
                                 Fill="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="CompactScannerStatusText"
                                   Margin="5,0,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="9"
                                   Text="Scanner idle" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CompactModeTitleButton"
                            Style="{DynamicResource IconButton}"
                            Content="▣"
                            ToolTip="Switch to compact overlay"
                            Click="CompactModeButton_Click" />
                    <Button x:Name="ExpandedModeTitleButton"
                            Visibility="Collapsed"
                            Style="{DynamicResource IconButton}"
                            Content="□"
                            ToolTip="Return to expanded dashboard"
                            Click="ExpandedModeButton_Click" />
                    <Button Style="{DynamicResource IconButton}"
                            Content="—"
                            ToolTip="Minimize"
                            Click="MinimizeButton_Click" />
                    <Button Style="{DynamicResource IconButton}"
                            Foreground="{DynamicResource ErrorRedBrush}"
                            Content="×"
                            ToolTip="Close"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Border x:Name="NavigationBar"
                    Grid.Row="1"
                    Margin="20,0,20,8"
                    Padding="3"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource MutedBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">
                <Grid x:Name="NavigationTrack" SizeChanged="NavigationTrack_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="NavigationBubble" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1" CornerRadius="10" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="NavigationBubbleScale" />
                                <TranslateTransform x:Name="NavigationBubbleTranslate" />
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                    <Button x:Name="DashboardTabButton"
                            Style="{DynamicResource NavigationTabButtonActive}"
                            Content="DASHBOARD"
                            Click="DashboardTabButton_Click" />
                    <Button x:Name="SettingsTabButton"
                            Grid.Column="1"
                            Style="{DynamicResource NavigationTabButton}"
                            Content="SETTINGS"
                            Click="SettingsTabButton_Click" />
                </Grid>
            </Border>

            <Grid x:Name="ExpandedDashboard" Grid.Row="2" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" />
                </Grid.RenderTransform>
                <ScrollViewer x:Name="MainScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly"
                              RenderTransformOrigin="0.5,0.5">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform X="0" />
                    </ScrollViewer.RenderTransform>
                    <StackPanel Margin="20,0,20,22">
                        <Border Margin="0,2,0,12"
                                Padding="18,15"
                                Background="{DynamicResource HeroCardBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Text="YOUR PERSONAL HEIST LEDGER" />
                                    <WrapPanel>
                                        <TextBlock x:Name="DashboardGreetingPrefixText"
                                                   Foreground="{DynamicResource ScannerCyanBrush}"
                                                   FontFamily="Segoe Script, Brush Script MT"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Text="Welcome, " />
                                        <TextBlock x:Name="DashboardGreetingNameText"
                                                   Margin="4,0,0,0"
                                                   Foreground="{DynamicResource EarningsGreenBrush}"
                                                   FontFamily="Segoe Script, Brush Script MT"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Text="Player" />
                                    </WrapPanel>
                                    <TextBlock x:Name="DashboardDateText"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Text="Your heist ledger is ready." />
                                    <Border x:Name="UsernameTipBorder"
                                            Margin="0,9,0,0"
                                            Padding="9,6"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource AccentSurfaceBrush}"
                                            BorderBrush="{DynamicResource AccentBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" Text="TIP  •  Set your player name in Settings → Profile" />
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="46"
                                        Height="46"
                                        Background="{DynamicResource AccentSurfaceBrush}"
                                        BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource EarningsGreenBrush}" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Bold" FontSize="17" Text="HL" />
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{DynamicResource StatusPill}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="LiveScannerDot" Width="8" Height="8" Fill="{DynamicResource MutedTextBrush}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{DynamicResource MicroLabel}" FontSize="9" Text="QUICK SCAN" />
                                        <TextBlock x:Name="LiveScannerStatusText" Margin="0,2,0,0" FontSize="10" Text="Select area" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{DynamicResource StatusPill}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="OcrReadyDot" Width="8" Height="8" Fill="{DynamicResource MutedTextBrush}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{DynamicResource MicroLabel}" FontSize="9" Text="OCR ENGINE" />
                                        <TextBlock x:Name="OcrReadyStatusText" Margin="0,2,0,0" FontSize="10" Text="Standby" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="4" Style="{DynamicResource StatusPill}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="CaptureAreaDot" Width="8" Height="8" Fill="{DynamicResource WarningGoldBrush}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{DynamicResource MicroLabel}" FontSize="9" Text="CAPTURE AREA" />
                                        <TextBlock x:Name="CaptureAreaStatusText" Margin="0,2,0,0" FontSize="10" Text="Not set" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Padding="14"
                                Background="{DynamicResource AccentSurfaceBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="13">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.35*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{DynamicResource MicroLabel}" Text="QUICK CAPTURE" />
                                    <TextBlock x:Name="QuickCaptureStatusText"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="10"
                                               Text="Capture and verify your selected GTA payout area"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="QuickCaptureButton"
                                        Grid.Column="2"
                                        Height="48"
                                        Style="{DynamicResource PrimaryButton}"
                                        Content="SCAN PAYOUT"
                                        Click="QuickCaptureButton_Click" />
                            <TextBlock x:Name="QuickScanHotkeyHintText"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="9"
                                       Text="Shortcut: Ctrl + Shift + H" />
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="19"
                                Background="{DynamicResource HeroCardBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource MicroLabel}" Text="LAST 24 HOURS" />
                                <TextBlock x:Name="DayTotalText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource EarningsGreenBrush}"
                                           FontFamily="Impact, Haettenschweiler, Arial Narrow"
                                           FontSize="42"
                                           Text="$0"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Height="2"
                                        Margin="0,10,0,12"
                                        Background="{DynamicResource DarkGreenBrush}"
                                        CornerRadius="1"
                                        Opacity="0.7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   Text="24-hour earning session" />
                                        <TextBlock x:Name="DayCountdownText"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource EarningsGreenBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Text="Starts with your next payout" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="Last payout  " />
                                        <TextBlock x:Name="HeroLastPayoutText" FontFamily="Impact, Haettenschweiler, Arial Narrow" FontSize="12" Text="$0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{DynamicResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Style="{DynamicResource MicroLabel}" Text="7 DAY TOTAL" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource ScannerCyanBrush}" FontSize="13" Text="▥" />
                                    </Grid>
                                    <TextBlock x:Name="WeekTotalText"
                                               Margin="0,8,0,0"
                                               FontFamily="Impact, Haettenschweiler, Arial Narrow"
                                               FontSize="22"
                                               Text="$0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="WeekCountdownText"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource ScannerCyanBrush}"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               Text="Starts with your next payout" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{DynamicResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Style="{DynamicResource MicroLabel}" Text="LAST PAYOUT" />
                                        <Ellipse Width="7" Height="7" HorizontalAlignment="Right" Fill="{DynamicResource EarningsGreenBrush}" />
                                    </Grid>
                                    <TextBlock x:Name="LastPayoutText"
                                               Margin="0,8,0,0"
                                               FontFamily="Impact, Haettenschweiler, Arial Narrow"
                                               FontSize="22"
                                               Text="$0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="LastPayoutTimestampText"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10"
                                               Text="No transactions yet" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{DynamicResource MicroLabel}" Text="WEEKLY HISTORY" />
                                    <TextBlock x:Name="SelectedWeekText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="9"
                                               Text="THIS WEEK" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Height="26" MinWidth="30" Padding="8,0" Style="{DynamicResource GhostButton}" Content="‹" ToolTip="Previous week" Click="PreviousWeekButton_Click" />
                                        <Button x:Name="NextWeekButton" Height="26" MinWidth="30" Margin="5,0,0,0" Padding="8,0" Style="{DynamicResource GhostButton}" Content="›" ToolTip="Next week" Click="NextWeekButton_Click" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl x:Name="WeeklyChartItems" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="108" Margin="4,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="22" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0"
                                                        Width="22"
                                                        Height="{Binding BarHeight}"
                                                        VerticalAlignment="Bottom"
                                                        Background="{DynamicResource EarningsGreenBrush}"
                                                        CornerRadius="5,5,2,2"
                                                        Opacity="{Binding Opacity}"
                                                        ToolTip="{Binding AmountText}" />
                                                <TextBlock Grid.Row="1"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Bottom"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontSize="10"
                                                           Text="{Binding DayLabel}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ManualEntryCard"
                                Visibility="Collapsed"
                                Margin="0,12,0,0"
                                Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource MicroLabel}" Text="ADD TRANSACTION" />
                                <Grid Height="46" Margin="0,10,0,0">
                                    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Margin="1"
                                                Background="#121A2531"
                                                BorderBrush="{DynamicResource MutedBorderBrush}"
                                                BorderThickness="0,0,1,0"
                                                CornerRadius="9,0,0,9">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource EarningsGreenBrush}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Text="$" />
                                        </Border>
                                        <TextBox x:Name="AmountTextBox"
                                                 Grid.Column="1"
                                                 Padding="12,0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 CaretBrush="{DynamicResource PrimaryTextBrush}"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 FontFamily="Segoe UI Variable Text, Segoe UI"
                                                 FontSize="15"
                                                 MaxLength="24"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Examples: 500000, 500,000, or $500,000"
                                                 TextChanged="AmountTextBox_TextChanged"
                                                 KeyDown="AmountTextBox_KeyDown" />
                                        <TextBlock x:Name="AmountPlaceholderText"
                                                   Grid.Column="1"
                                                   Margin="13,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="12"
                                                   IsHitTestVisible="False"
                                                   Text="Enter payout amount"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>

                                <TextBlock x:Name="ValidationText"
                                           MinHeight="14"
                                           Margin="2,6,2,0"
                                           Foreground="{DynamicResource ErrorRedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AddEarningButton"
                                            Grid.Column="0"
                                            Style="{DynamicResource PrimaryButton}"
                                            Content="Add Earning"
                                            Click="AddEarningButton_Click" />
                                    <Button x:Name="UndoLastButton"
                                            Grid.Column="2"
                                            Style="{DynamicResource SecondaryButton}"
                                            Content="Undo Last"
                                            IsEnabled="False"
                                            Click="UndoLastButton_Click" />
                                </Grid>

                                <Grid Margin="2,11,2,0">
                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Text="Transactions saved locally" />
                                    <TextBlock x:Name="LastUpdatedText"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10"
                                               Text="Last updated: --" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{DynamicResource MicroLabel}" Text="TRANSACTION HISTORY" />
                                    <TextBlock x:Name="HistoryDayTotalText"
                                               Grid.Column="1"
                                               Margin="12,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource EarningsGreenBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="$0" />
                                    <Button x:Name="RecentUndoButton"
                                            Grid.Column="2"
                                            Visibility="Collapsed"
                                            Height="28"
                                            Padding="10,0"
                                            HorizontalAlignment="Right"
                                            Style="{DynamicResource GhostButton}"
                                            Content="Undo Last"
                                            Click="UndoLastButton_Click" />
                                </Grid>
                                <Expander Margin="0,12,0,8"
                                          IsExpanded="False"
                                          Style="{DynamicResource PremiumExpander}">
                                    <Expander.Header>
                                        <Grid Width="380">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{DynamicResource MicroLabel}" Text="EARNING CALENDAR" />
                                                <TextBlock x:Name="SelectedHistoryDateText" Margin="0,3,0,0" Foreground="{DynamicResource EarningsGreenBrush}" FontSize="10" FontWeight="SemiBold" Text="Today" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Width="30"
                                                    Height="30"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentSurfaceBrush}"
                                                    BorderBrush="{DynamicResource AccentBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe UI Symbol"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource EarningsGreenBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="▼" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                             Value="True">
                                                                    <Setter Property="Text" Value="▲" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <Border Margin="0,10,0,0"
                                        Padding="12"
                                        Background="{DynamicResource SecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource MutedBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Height="30" MinWidth="34" Padding="8,0" Style="{DynamicResource GhostButton}" Content="‹" ToolTip="Previous month" Click="PreviousCalendarMonthButton_Click" />
                                            <TextBlock x:Name="CalendarMonthText"
                                                       Grid.Column="1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="July 2026" />
                                            <Button x:Name="NextCalendarMonthButton" Grid.Column="2" Height="30" MinWidth="34" Padding="8,0" Style="{DynamicResource GhostButton}" Content="›" ToolTip="Next month" Click="NextCalendarMonthButton_Click" />
                                        </Grid>
                                        <UniformGrid Margin="2,12,2,5" Columns="7">
                                            <TextBlock Style="{DynamicResource CalendarWeekdayLabel}" Text="S" />
                                            <TextBlock Style="{DynamicResource CalendarWeekdayLabel}" Text="M" />
                                            <TextBlock Style="{DynamicResource CalendarWeekdayLabel}" Text="T" />
                                            <TextBlock Style="{DynamicResource CalendarWeekdayLabel}" Text="W" />
                                            <TextBlock Style="{DynamicResource CalendarWeekdayLabel}" Text="T" />
                                            <TextBlock Style="{DynamicResource CalendarWeekdayLabel}" Text="F" />
                                            <TextBlock Style="{DynamicResource CalendarWeekdayLabel}" Text="S" />
                                        </UniformGrid>
                                        <ItemsControl x:Name="CalendarDayItems">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" Rows="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Height="36"
                                                            Margin="2"
                                                            Padding="0"
                                                            AutomationProperties.Name="{Binding Date, StringFormat={}{0:dddd, MMMM d}}"
                                                            IsEnabled="{Binding IsEnabled}"
                                                            Tag="{Binding Date}"
                                                            ToolTip="{Binding Date, StringFormat={}{0:dddd, MMMM d}}"
                                                            Click="CalendarDayButton_Click">
                                                        <Grid>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Text="{Binding DayText}" />
                                                            <Ellipse Width="4" Height="4" Margin="0,0,0,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{DynamicResource EarningsGreenBrush}">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasEarnings}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                        </Grid>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource CalendarDayButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.32" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource ScannerCyanBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource EarningsGreenBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource EarningsGreenBrush}" />
                                                                        <Setter Property="Foreground" Value="#FF081009" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </Border>
                                </Expander>
                                <ItemsControl x:Name="RecentActivityItems" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="43">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="68" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="22" Height="22" Fill="#1FA6FF5F" Stroke="#55A6FF5F" StrokeThickness="1" />
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource EarningsGreenBrush}" FontSize="11" Text="+" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding SourceLabel}" />
                                                    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" Text="{Binding LocalTimeText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource EarningsGreenBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding AmountText}" />
                                                <Button Grid.Column="3"
                                                        Height="28"
                                                        Margin="10,0,0,0"
                                                        Padding="8,0"
                                                        VerticalAlignment="Center"
                                                        Style="{DynamicResource DangerButton}"
                                                        FontSize="9"
                                                        Content="DELETE"
                                                        Tag="{Binding RecordId}"
                                                        Click="DeleteRecentEarningButton_Click" />
                                                <Border Grid.ColumnSpan="4"
                                                        Height="1"
                                                        VerticalAlignment="Bottom"
                                                        Background="{DynamicResource MutedBorderBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoRecentActivityText"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11"
                                           Text="No earnings saved for this day." />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{DynamicResource Card}" Visibility="Collapsed">
                            <Expander x:Name="PayoutScannerExpander"
                                      Style="{DynamicResource PremiumExpander}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{DynamicResource MicroLabel}" Foreground="{DynamicResource ScannerCyanBrush}" Text="PAYOUT SCANNER" />
                                            <TextBlock x:Name="ScannerCollapsedStatusText"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="10"
                                                       Text="Idle • No capture area" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Width="30"
                                                Height="30"
                                                Background="{DynamicResource SecondaryBackgroundBrush}"
                                                BorderBrush="{DynamicResource MutedBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" Text="⌄" />
                                        </Border>
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock x:Name="CaptureAreaText"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="10"
                                               Text="Capture area: Not selected"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="9"
                                               Text="Select either the complete TOTAL CASH EARNED result or the green cash icon with the full amount beside it. Leave a small border around everything."
                                               TextWrapping="Wrap" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.35*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SelectCaptureAreaButton"
                                                Grid.Column="0"
                                                Style="{DynamicResource SecondaryButton}"
                                                Content="CHANGE CAPTURE AREA"
                                                Click="SelectCaptureAreaButton_Click" />
                                        <Button x:Name="TestCaptureButton"
                                                Grid.Column="2"
                                                Style="{DynamicResource GhostButton}"
                                                Content="Test Capture"
                                                Click="TestCaptureButton_Click" />
                                        <Button x:Name="ClearCaptureAreaButton"
                                                Grid.Column="4"
                                                Style="{DynamicResource DangerButton}"
                                                Content="Clear"
                                                Click="ClearCaptureAreaButton_Click" />
                                    </Grid>

                                    <Grid Margin="2,12,2,0">
                                        <CheckBox x:Name="LivePreviewCheckBox"
                                                  Style="{DynamicResource ToggleSwitch}"
                                                  Content="Live Preview"
                                                  Checked="LivePreviewCheckBox_Checked"
                                                  Unchecked="LivePreviewCheckBox_Unchecked" />
                                    </Grid>

                                    <Border Height="150"
                                            MaxHeight="180"
                                            Margin="0,12,0,0"
                                            Background="#FF090D12"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="11"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image x:Name="CapturePreviewImage"
                                                   Margin="6"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Stretch="Uniform" />
                                            <TextBlock x:Name="CapturePreviewPlaceholderText"
                                                       Margin="20"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11"
                                                       IsHitTestVisible="False"
                                                       Text="Capture preview will appear here"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="CaptureStatusText"
                                               MinHeight="14"
                                               Margin="2,7,2,0"
                                               Foreground="{DynamicResource ScannerCyanBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />

                                    <Border Height="1" Margin="0,13,0,0" Background="{DynamicResource MutedBorderBrush}" />

                                    <Button x:Name="AnalyzeCaptureButton"
                                            Style="{DynamicResource PrimaryButton}"
                                            Content="Analyze Current Capture"
                                            Click="AnalyzeCaptureButton_Click" />

                                    <CheckBox x:Name="AutomaticDetectionCheckBox"
                                              Visibility="Collapsed"
                                              Margin="2,12,2,0"
                                              Style="{DynamicResource ToggleSwitch}"
                                              Content=""
                                              Checked="AutomaticDetectionCheckBox_Checked"
                                              Unchecked="AutomaticDetectionCheckBox_Unchecked" />

                                    <TextBlock x:Name="OcrStatusText"
                                               MinHeight="14"
                                               Margin="2,8,2,0"
                                               Foreground="{DynamicResource EarningsGreenBrush}"
                                               FontSize="10"
                                               Text="OCR is idle."
                                               TextWrapping="Wrap" />

                                    <Expander Margin="0,10,0,0"
                                              Style="{DynamicResource PremiumExpander}">
                                        <Expander.Header>
                                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Text="OCR diagnostics  ›" />
                                        </Expander.Header>
                                        <Border Margin="0,8,0,0"
                                                Padding="12"
                                                Background="{DynamicResource SecondaryBackgroundBrush}"
                                                BorderBrush="{DynamicResource MutedBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <StackPanel>
                                                <TextBlock Style="{DynamicResource MicroLabel}" FontSize="9" Text="LATEST RAW OCR TEXT" />
                                                <TextBlock x:Name="DiagnosticRawText"
                                                           Margin="0,5,0,0"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           Text="(none)"
                                                           TextWrapping="Wrap" />
                                                <TextBlock x:Name="DiagnosticConfidenceText" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Text="Confidence: --" />
                                                <TextBlock x:Name="DiagnosticMethodText" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Text="Preprocessing: --" />
                                                <TextBlock x:Name="DiagnosticDetectionMethodText" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Text="Detection method: --" />
                                                <TextBlock x:Name="DiagnosticScanTimeText" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Text="Last scan: --" />
                                                <TextBlock x:Name="DiagnosticStatusText" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Text="Scan status: Idle" TextWrapping="Wrap" />
                                                <Border Height="1" Margin="0,9,0,7" Background="{DynamicResource MutedBorderBrush}" />
                                                <TextBlock Style="{DynamicResource MicroLabel}" FontSize="9" Text="GTA RESULT-SCREEN DETECTOR" />
                                                <TextBlock x:Name="GtaDiagnosticSummaryText"
                                                           Margin="0,5,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontFamily="Consolas"
                                                           FontSize="9"
                                                           Text="No specialized scan data."
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,9,0,0" Style="{DynamicResource MicroLabel}" FontSize="9" Text="AMOUNT OCR VARIANTS" />
                                                <TextBlock x:Name="GtaVariantDiagnosticsText"
                                                           Margin="0,5,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontFamily="Consolas"
                                                           FontSize="8"
                                                           Text="(none)"
                                                           TextWrapping="Wrap" />
                                                <StackPanel x:Name="GtaDiagnosticPreviewPanel"
                                                            Margin="0,9,0,0"
                                                            Orientation="Horizontal"
                                                            Visibility="Collapsed">
                                                    <Image x:Name="GtaHeadingCropPreview" Width="105" Height="65" Margin="0,0,5,0" Stretch="Uniform" />
                                                    <Image x:Name="GtaAmountCropPreview" Width="105" Height="65" Margin="0,0,5,0" Stretch="Uniform" />
                                                    <Image x:Name="GtaProcessedAmountPreview" Width="105" Height="65" Stretch="Uniform" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Border x:Name="PayoutConfirmationCard"
                                Visibility="Collapsed"
                                Margin="0,12,0,0"
                                Padding="17"
                                Background="#FF14251C"
                                BorderBrush="{DynamicResource EarningsGreenBrush}"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Border.RenderTransform>
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="ConfirmationHeadingText"
                                               Foreground="{DynamicResource EarningsGreenBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="PAYOUT REQUIRES CONFIRMATION" />
                                    <Border HorizontalAlignment="Right" Padding="8,3" Background="#22A6FF5F" CornerRadius="7">
                                        <TextBlock Foreground="{DynamicResource EarningsGreenBrush}" FontSize="9" Text="MANUAL REVIEW" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="DetectedPayoutText"
                                           Margin="0,8,0,0"
                                           FontFamily="Impact, Haettenschweiler, Arial Narrow"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Text="Detected payout: $0" />
                                <TextBlock x:Name="RecognizedPayoutText"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Text="Recognized text:"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ConfirmationMetaText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="10"
                                           Text="Confidence: -- • Preprocessing: --"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ConfirmationVerificationStatusText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource WarningGoldBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Text="VERIFICATION REQUIRED" />
                                <TextBlock x:Name="ConfirmationDiagnosticsText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Text="Readers: --"
                                           TextWrapping="Wrap" />
                                <Border x:Name="ExpandedPreviousResultBorder" Visibility="Collapsed" Margin="0,8,0,0" Padding="8" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource WarningGoldBrush}" BorderThickness="1" CornerRadius="7">
                                    <TextBlock x:Name="ExpandedPreviousResultText" Foreground="{DynamicResource WarningGoldBrush}" FontSize="10" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock x:Name="ExpandedScanAttemptsText" Visibility="Collapsed" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" />
                                <Grid x:Name="ConfirmationPreviewPanel"
                                      Visibility="Collapsed"
                                      Height="150"
                                      Margin="0,10,0,0">
                                    <Border Grid.Column="0" Background="#FF090D12" BorderBrush="{DynamicResource MutedBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                        <Image x:Name="ConfirmationAmountCropImage" Margin="4" Stretch="Uniform" />
                                    </Border>
                                </Grid>
                                <Border x:Name="ExpandedEditPanel"
                                        Visibility="Collapsed"
                                        Margin="0,10,0,0"
                                        Padding="10"
                                        Background="{DynamicResource SecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource ScannerCyanBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource MicroLabel}" FontSize="9" Text="EDIT DETECTED AMOUNT" />
                                        <TextBox x:Name="ExpandedEditAmountTextBox" Height="46" Margin="0,9,0,0" Padding="12,0" Style="{DynamicResource PremiumAmountTextBox}" FontFamily="Impact, Haettenschweiler, Arial Narrow" FontSize="19" VerticalContentAlignment="Center" KeyDown="PendingEditTextBox_KeyDown" />
                                        <TextBlock x:Name="ExpandedEditValidationText" MinHeight="14" Margin="2,5,2,0" Foreground="{DynamicResource ErrorRedBrush}" FontSize="10" TextWrapping="Wrap" />
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Button Style="{DynamicResource PrimaryButton}" Content="SAVE PAYOUT" Click="SaveEditedPayoutButton_Click" />
                                            <Button Grid.Column="2" Style="{DynamicResource GhostButton}" Content="CANCEL" Click="CancelEditedPayoutButton_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ExpandedAcceptButton" Grid.Column="0" Style="{DynamicResource PrimaryButton}" Content="ACCEPT" Click="ConfirmPayoutButton_Click" />
                                    <Button x:Name="ExpandedEditButton" Grid.Column="2" Style="{DynamicResource SecondaryButton}" Content="EDIT" Click="EditDetectedAmountButton_Click" />
                                    <Button x:Name="ExpandedRescanButton" Grid.Column="4" Style="{DynamicResource SecondaryButton}" Content="RESCAN" Click="RescanPayoutButton_Click" />
                                    <Button x:Name="ExpandedRejectButton" Grid.Column="6" Style="{DynamicResource DangerButton}" Content="REJECT" Click="RejectPayoutButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsScrollViewer"
                              Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly"
                              RenderTransformOrigin="0.5,0.5">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform X="0" />
                    </ScrollViewer.RenderTransform>
                    <StackPanel Margin="20,4,20,22">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="SETTINGS" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   Text="Configure the overlay without changing its passive security model." />

                        <Border Margin="0,14,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource MicroLabel}" Text="PLAYER PROFILE" />
                                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Text="Your name appears in greetings and Discord payout posts." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Padding="9,5" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="9">
                                        <TextBlock Foreground="{DynamicResource EarningsGreenBrush}" FontSize="9" FontWeight="SemiBold" Text="PROFILE" />
                                    </Border>
                                </Grid>
                                <TextBlock Margin="0,13,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Text="Player name" />
                                <TextBox x:Name="ProfileUsernameTextBox"
                                         Height="44"
                                         Margin="0,6,0,0"
                                         Padding="12,0"
                                         Style="{DynamicResource PremiumAmountTextBox}"
                                         FontFamily="Segoe UI Variable Text, Segoe UI"
                                         FontSize="13"
                                         MaxLength="80"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Leave blank to use Player" />
                                <Button Margin="0,10,0,0" Style="{DynamicResource PrimaryButton}" Content="SAVE PLAYER NAME" Click="SaveProfileButton_Click" />
                                <TextBlock x:Name="ProfileStatusText" Margin="2,8,2,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Text="If blank, the app will call you Player." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource MicroLabel}" Text="APPEARANCE" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           Text="Choose a color atmosphere for the dashboard and compact overlay."
                                           TextWrapping="Wrap" />
                                <ComboBox x:Name="ThemeComboBox"
                                          Margin="0,12,0,0"
                                          SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="Dark" Content="Dark — Heist Ledger" />
                                    <ComboBoxItem Tag="Light" Content="Light — Clean Daylight" />
                                    <ComboBoxItem Tag="Purple" Content="Purple — Neon Club" />
                                    <ComboBoxItem Tag="Galaxy" Content="Galaxy — Cosmic Blue" />
                                    <ComboBoxItem Tag="Midnight" Content="Midnight — Deep Ocean" />
                                    <ComboBoxItem Tag="Crimson" Content="Crimson — High Stakes" />
                                </ComboBox>
                                <StackPanel Margin="2,12,2,0" Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Fill="#A6FF5F" />
                                    <Ellipse Width="12" Height="12" Margin="7,0,0,0" Fill="#C98CFF" />
                                    <Ellipse Width="12" Height="12" Margin="7,0,0,0" Fill="#78E4FF" />
                                    <Ellipse Width="12" Height="12" Margin="7,0,0,0" Fill="#FF718A" />
                                    <TextBlock Margin="10,-1,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10"
                                               Text="Theme changes apply instantly" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource MicroLabel}" Text="QUICK SCAN SHORTCUT" />
                                <CheckBox x:Name="HotkeyEnabledCheckBox"
                                          Margin="0,14,0,0"
                                          Style="{DynamicResource ToggleSwitch}"
                                          Content="Enable Quick Scan shortcut" />
                                <Border Margin="0,13,0,0"
                                        Padding="12"
                                        Background="{DynamicResource SecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource MutedBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
