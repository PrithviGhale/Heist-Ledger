                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ScannerCyanBrush}"
                                                   FontSize="11"
                                                   Text="" />
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="HotkeyWarningText"
                                           Visibility="Collapsed"
                                           Margin="0,9,0,0"
                                           Foreground="{DynamicResource WarningGoldBrush}"
