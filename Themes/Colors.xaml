<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="MainBackgroundColor">#090D12</Color>
    <Color x:Key="SecondaryBackgroundColor">#0E141C</Color>
    <Color x:Key="ElevatedCardColor">#151D27</Color>
    <Color x:Key="ElevatedCardHoverColor">#1A2531</Color>
    <Color x:Key="BorderColor">#24313F</Color>
    <Color x:Key="MutedBorderColor">#1C2733</Color>
    <Color x:Key="PrimaryTextColor">#F4F7FA</Color>
    <Color x:Key="SecondaryTextColor">#94A3B4</Color>
    <Color x:Key="MutedTextColor">#667587</Color>
    <Color x:Key="EarningsGreenColor">#A6FF5F</Color>
    <Color x:Key="DarkGreenColor">#6FCB34</Color>
    <Color x:Key="ScannerCyanColor">#4DD7FF</Color>
    <Color x:Key="WarningGoldColor">#FFC857</Color>
    <Color x:Key="ErrorRedColor">#FF5C6C</Color>

    <SolidColorBrush x:Key="MainBackgroundBrush" Color="{StaticResource MainBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="ElevatedCardBrush" Color="{StaticResource ElevatedCardColor}" />
    <SolidColorBrush x:Key="ElevatedCardHoverBrush" Color="{StaticResource ElevatedCardHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="MutedBorderBrush" Color="{StaticResource MutedBorderColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="EarningsGreenBrush" Color="{StaticResource EarningsGreenColor}" />
    <SolidColorBrush x:Key="DarkGreenBrush" Color="{StaticResource DarkGreenColor}" />
    <SolidColorBrush x:Key="ScannerCyanBrush" Color="{StaticResource ScannerCyanColor}" />
    <SolidColorBrush x:Key="WarningGoldBrush" Color="{StaticResource WarningGoldColor}" />
    <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRedColor}" />
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#24A6FF5F" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#66A6FF5F" />
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#090D12" />

    <LinearGradientBrush x:Key="DashboardBackgroundBrush"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Offset="0" Color="#090D12" />
        <GradientStop Offset="1" Color="#101822" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroCardBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#18232B" />
        <GradientStop Offset="1" Color="#121B24" />
    </LinearGradientBrush>
</ResourceDictionary>
